{
  "rules": {
    ".read": false,
    ".write": false,
    "lobbies": {
      "$lobbyCode": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "users": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null && auth.uid === $userId"
      }
    }
  }
}
