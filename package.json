{
  "name": "party-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test:careers": "node scripts/validate-career-data.cjs && node --experimental-strip-types --test scripts/career-matching.test.mjs",
    "test:profile": "node --experimental-strip-types --test scripts/profile-session.test.mjs",
    "test:scoring": "node --experimental-strip-types --test scripts/piu-vicino-scoring.test.mjs",
    "test:podium": "node --experimental-strip-types --test scripts/podium-ranking.test.mjs",
    "test:images": "node --experimental-strip-types --test scripts/image-game-data.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "cheerio": "^1.2.0",
    "firebase": "^12.16.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.26.0",
    "node-fetch": "^2.7.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-easy-crop": "^6.2.3",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
